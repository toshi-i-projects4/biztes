rules_version = '2';

// ビズてす専用 Firestore セキュリティルール（v2：企業管理者ロール追加版）
//
// 前提:
// - オペレーター（ビズてす運営者）は Firebase Auth のメール/パスワードでログインし、
//   operators/{uid} ドキュメントが存在することで判定する。全企業のデータを横断して
//   閲覧・操作できる（企業の新規登録・停止もオペレーターのみ）。
// - 企業管理者（応募企業側の担当者）も同じく Firebase Auth のメール/パスワードで
//   ログインし、companyAdmins/{uid} ドキュメントが存在し status が "active" で
//   あることで判定する。companyAdmins/{uid}.companyId に一致する自社の範囲でのみ、
//   問題編集・受験招待発行・受験結果確認・自社の追加管理者の招待ができる。
//   1社に複数の企業管理者アカウントを持たせることができる。
// - 企業管理者アカウントは、オペレーターまたは既存の企業管理者が
//   pendingCompanyAdmins/{email} に招待レコードを作成し、招待された本人が
//   company-admin-signup.html でパスワードを設定して本登録（セルフサインアップ）する。
// - オペレーターアカウントも同様に、既存のオペレーターが pendingOperators/{email} に
//   招待レコードを作成し、招待された本人が operator-signup.html でパスワードを設定して
//   本登録する（scripts/create-operator.mjs による作成は、最初の1名を用意する場合のみ使用）。
//   また、既に企業管理者として登録済みのアカウントに運営権限だけを追加で付与すること、
//   その逆に運営権限だけを解除すること（企業管理者としての登録は維持）もできる。
// - 応募者（受験者）は Firebase Anonymous Auth でサインインし、
//   companies/{companyId}/examInvites/{token} の招待トークンを知っていることを前提に受験する。
//
// 既知の制約（v1時点であえて厳密にしていない箇所、v2でも維持）:
// - questionSets / items は「サインイン済みであれば companyId が分かれば読める」設計にしている。
//   応募者は受験中に自社の問題を読めればよく、他社の問題も理論上読める状態になる
//   （companyIdは推測困難ではないため）。問題文自体は機密性が極めて高い情報ではない想定で
//   割り切っているが、将来的にはCloud Functions経由でトークン検証してから問題を配信する方式へ
//   強化することを推奨する。
// - （v6で追加）templates / partDefinitions / companies/{companyId}/customParts も同様の考え方で、
//   サインイン済みであれば読める設計にしている。企業が自社パートに1問も問題を登録していない場合、
//   受験者は templates（運営のデフォルト問題）をそのまま読んで受験する。書き込みはこれまで通り
//   templates・partDefinitionsはオペレーターのみ、customPartsはオペレーターまたは自社の企業管理者のみ。
// - examInvites / examResults は token（ドキュメントID）を知らなければ辿り着けない前提。
// - companies/{companyId} 自体の get は、応募者の受験導線（企業名表示など）を壊さないため、
//   引き続き「サインイン済みであれば誰でも閲覧可」の広い設定を維持する。企業の新規登録・
//   状態変更（write）はオペレーターのみに限定している。

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ---- オペレーター（運営者）判定 ----
    function isOperator() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/operators/$(request.auth.uid));
    }

    // ---- 企業管理者判定 ----
    function hasCompanyAdminDoc() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/companyAdmins/$(request.auth.uid));
    }
    function myCompanyAdmin() {
      return get(/databases/$(database)/documents/companyAdmins/$(request.auth.uid)).data;
    }
    function isCompanyAdmin() {
      return hasCompanyAdminDoc() && myCompanyAdmin().status == "active";
    }
    function myCompanyId() {
      return myCompanyAdmin().companyId;
    }
    // 指定した companyId が、自分（企業管理者）の所属企業と一致するか
    function sameCompany(companyId) {
      return isCompanyAdmin() && myCompanyId() == companyId;
    }
    // ビズてす申込者（自社の初回申込みを行った本人）かどうか
    function isApplicantCompanyAdmin() {
      return isCompanyAdmin() && myCompanyAdmin().isApplicant == true;
    }
    // terms-agreement.html：申込者本人が、自社の利用規約同意（termsAccepted /
    // serviceEnabled を true にする）を行えるかどうか
    function canAcceptCompanyTerms(companyId) {
      return isApplicantCompanyAdmin() && sameCompany(companyId);
    }

    // ---- pendingCompanyAdmins（企業管理者の招待） ----
    function isOwnPendingCompanyAdmin(pendingEmail) {
      return isSignedIn() && request.auth.token.email == pendingEmail;
    }
    function pendingCompanyAdmin(email) {
      return get(/databases/$(database)/documents/pendingCompanyAdmins/$(email)).data;
    }
    function pendingCompanyAdminExists(email) {
      return exists(/databases/$(database)/documents/pendingCompanyAdmins/$(email));
    }
    // 招待された本人が company-admin-signup.html で本登録する際の書き込み検証
    function canCreateOwnCompanyAdminFromPending(uid) {
      return isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && pendingCompanyAdminExists(request.resource.data.email)
        && pendingCompanyAdmin(request.resource.data.email).email == request.auth.token.email
        && pendingCompanyAdmin(request.resource.data.email).status == "pending"
        && request.resource.data.companyId == pendingCompanyAdmin(request.resource.data.email).companyId
        && request.resource.data.name == pendingCompanyAdmin(request.resource.data.email).name
        && request.resource.data.employeeCode == pendingCompanyAdmin(request.resource.data.email).employeeCode
        && request.resource.data.department == pendingCompanyAdmin(request.resource.data.email).department
        && request.resource.data.position == pendingCompanyAdmin(request.resource.data.email).position
        && request.resource.data.isApplicant == pendingCompanyAdmin(request.resource.data.email).isApplicant
        && request.resource.data.role == "companyAdmin"
        && request.resource.data.status == "active"
        && request.resource.data.keys().hasOnly([
          "uid", "name", "email", "companyId", "employeeCode", "department", "position",
          "role", "status", "isApplicant", "note",
          "createdAt", "createdBy", "updatedAt", "updatedBy"
        ]);
    }
    // 同じ企業内の他の企業管理者（自分自身を含む）のプロフィール項目を編集する際の型検証
    function validCompanyAdminProfileFields() {
      return (!("employeeCode" in request.resource.data) || request.resource.data.employeeCode is string)
        && (!("name" in request.resource.data) || request.resource.data.name is string)
        && (!("department" in request.resource.data) || request.resource.data.department is string)
        && (!("position" in request.resource.data) || request.resource.data.position is string)
        && (!("email" in request.resource.data) || request.resource.data.email is string)
        && (!("note" in request.resource.data) || request.resource.data.note is string)
        && (!("isApplicant" in request.resource.data) || request.resource.data.isApplicant is bool)
        && (!("status" in request.resource.data) || request.resource.data.status in ["active", "inactive"]);
    }
    // company-admin-invite.html：企業管理者が、同じ企業の企業管理者（自分自身も含む）の
    // 社員コード・氏名・部署・役職・メールアドレス・備考・ビズてす申込者フラグを編集できる。
    // （このメールアドレスはプロフィール上の表示用項目であり、Firebase Authenticationの
    // ログイン用メールアドレスとは別。ログイン用メールアドレスの変更・同期は
    // account-settings.html → canUpdateOwnCompanyAdminEmail() の経路を使う。）
    // ただし自分自身のstatus（有効/無効）だけは、この経路からは変更できない
    // （誤って自分自身を無効化してしまうことを防止）。
    function canCompanyAdminUpdateSameCompanyAdmin(uid) {
      return isCompanyAdmin()
        && resource.data.companyId == myCompanyId()
        && request.resource.data.companyId == myCompanyId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "employeeCode", "name", "department", "position", "email", "note", "isApplicant", "status",
          "updatedAt", "updatedBy"
        ])
        && (
          request.auth.uid != uid ||
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["status"])
        )
        && validCompanyAdminProfileFields();
    }

    // account-settings.html：企業管理者本人によるメールアドレス更新。
    // Firebase Authenticationのメールアドレスを変更した後、companyAdmins側のemailを
    // 本人が同期できるようにする（それ以外のフィールドは変更不可）。
    function canUpdateOwnCompanyAdminEmail(uid) {
      return isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "email", "updatedAt", "updatedBy",
          "emailSyncPending", "pendingAuthEmail", "emailSyncError", "emailSyncFailedAt"
        ])
        && request.resource.data.email is string
        && request.resource.data.updatedBy == request.auth.uid
        && (!("updatedAt" in request.resource.data) || request.resource.data.updatedAt is timestamp)
        && (!("emailSyncPending" in request.resource.data) || request.resource.data.emailSyncPending is bool)
        && (!("pendingAuthEmail" in request.resource.data) || request.resource.data.pendingAuthEmail is string)
        && (!("emailSyncError" in request.resource.data) || request.resource.data.emailSyncError is string)
        && (!("emailSyncFailedAt" in request.resource.data) || request.resource.data.emailSyncFailedAt is timestamp);
    }

    // ---- pendingOperators（運営専任メンバーの招待） ----
    function isOwnPendingOperator(pendingEmail) {
      return isSignedIn() && request.auth.token.email == pendingEmail;
    }
    function pendingOperator(email) {
      return get(/databases/$(database)/documents/pendingOperators/$(email)).data;
    }
    function pendingOperatorExists(email) {
      return exists(/databases/$(database)/documents/pendingOperators/$(email));
    }
    // 招待された本人が operator-signup.html で本登録する際の書き込み検証
    // （企業に属さない運営専任メンバーの新規登録）
    function canCreateOwnOperatorFromPending(uid) {
      return isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && pendingOperatorExists(request.resource.data.email)
        && pendingOperator(request.resource.data.email).email == request.auth.token.email
        && pendingOperator(request.resource.data.email).status == "pending"
        && request.resource.data.name == pendingOperator(request.resource.data.email).name
        && request.resource.data.role == "operator"
        && request.resource.data.keys().hasOnly([
          "uid", "name", "email", "role", "createdAt", "createdBy"
        ]);
    }
    // 既存の企業管理者アカウントに、運営権限だけを追加で付与する
    // （operator-invite.html の「①」）。companyAdmins側の登録はそのまま維持され、
    // 対象uidにoperators/{uid}ドキュメントが新たに作られることで運営権限を持つ。
    function canGrantOperatorToExistingCompanyAdmin(uid) {
      return isOperator()
        && request.auth.uid != uid
        && exists(/databases/$(database)/documents/companyAdmins/$(uid))
        && get(/databases/$(database)/documents/companyAdmins/$(uid)).data.email == request.resource.data.email
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.role == "operator"
        && request.resource.data.keys().hasOnly([
          "uid", "name", "email", "role", "createdAt", "createdBy"
        ]);
    }

    // ---- オペレーターアカウント ----
    match /operators/{uid} {
      // 本人に加えて、他のオペレーターも一覧・招待管理画面のために閲覧できる
      allow get: if isSignedIn() && (request.auth.uid == uid || isOperator());
      allow list: if isOperator();
      // 新規オペレーター専任メンバーのセルフサインアップ、または
      // オペレーターによる既存企業管理者への運営権限付与のいずれか
      allow create: if canCreateOwnOperatorFromPending(uid) || canGrantOperatorToExistingCompanyAdmin(uid);
      allow update: if false;
      // 運営権限の解除＝ドキュメント削除。自分自身は解除できない（誤操作防止）。
      allow delete: if isOperator() && request.auth.uid != uid;
    }

    // ---- 運営専任メンバーの招待（pending） ----
    match /pendingOperators/{email} {
      allow read: if isOperator() ||
        (isOwnPendingOperator(email) && resource.data.email == request.auth.token.email);
      allow create: if isOperator()
        && request.resource.data.email == email
        && request.resource.data.status == "pending"
        && request.resource.data.keys().hasOnly([
          "email", "name", "note", "status",
          "createdAt", "createdBy", "updatedAt", "updatedBy",
          "registeredAt", "registeredUid"
        ]);
      allow update: if
        (
          isOperator()
          && request.resource.data.email == resource.data.email
          && request.resource.data.status in ["pending", "registered", "cancelled"]
        )
        ||
        (
          isOwnPendingOperator(email)
          && resource.data.email == request.auth.token.email
          && resource.data.status == "pending"
          && request.resource.data.email == resource.data.email
          && request.resource.data.name == resource.data.name
          && request.resource.data.status == "registered"
          && request.resource.data.registeredUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "registeredAt", "registeredUid", "updatedAt", "updatedBy"
          ])
        );
      allow delete: if false;
    }

    // ---- 企業管理者アカウント ----
    match /companyAdmins/{uid} {
      allow get: if isSignedIn() &&
        (request.auth.uid == uid || isOperator() ||
          (isCompanyAdmin() && resource.data.companyId == myCompanyId()));
      // list はクエリ結果の各ドキュメントに対してこのルールが評価されるため、
      // 自社の companyId で絞り込んだクエリのみが実質的に許可される。
      allow list: if isOperator() ||
        (isCompanyAdmin() && resource.data.companyId == myCompanyId());
      // オペレーターは任意企業の管理者アカウントを直接作成できる。
      // 企業管理者本人によるセルフサインアップは canCreateOwnCompanyAdminFromPending() 経由。
      allow create: if isOperator() || canCreateOwnCompanyAdminFromPending(uid);
      // 社員コード・氏名・部署・役職・備考・ビズてす申込者フラグ・status（有効/無効）の
      // 編集を許可。companyId・email・uid・role等の付け替えは不可。
      // 企業管理者は、同じ企業の管理者（自分自身を含む）のプロフィール項目を編集できるが、
      // 自分自身のstatusだけはこの経路から変更できない（誤って自分を無効化することを防止）。
      // account-settings.html から、本人がメールアドレスだけを同期更新することも許可する。
      allow update: if isOperator() || canCompanyAdminUpdateSameCompanyAdmin(uid) || canUpdateOwnCompanyAdminEmail(uid);
      // アカウントの完全削除は行わず、statusの無効化のみを運用とする。
      allow delete: if false;
    }

    // ---- 企業管理者の招待（pending） ----
    match /pendingCompanyAdmins/{email} {
      allow read: if isOperator() ||
        (isCompanyAdmin() && resource.data.companyId == myCompanyId()) ||
        (isOwnPendingCompanyAdmin(email) && resource.data.email == request.auth.token.email);
      allow create: if
        (
          isOperator()
          && request.resource.data.email == email
          && request.resource.data.status == "pending"
          && request.resource.data.keys().hasOnly([
            "email", "name", "companyId", "companyName", "employeeCode", "department",
            "position", "isApplicant", "note", "status",
            "createdAt", "createdBy", "updatedAt", "updatedBy",
            "registeredAt", "registeredUid"
          ])
        )
        ||
        (
          isCompanyAdmin()
          && request.resource.data.email == email
          && request.resource.data.status == "pending"
          && request.resource.data.companyId == myCompanyId()
          && request.resource.data.keys().hasOnly([
            "email", "name", "companyId", "companyName", "employeeCode", "department",
            "position", "isApplicant", "note", "status",
            "createdAt", "createdBy", "updatedAt", "updatedBy",
            "registeredAt", "registeredUid"
          ])
        );
      allow update: if
        (
          (isOperator() || (isCompanyAdmin() && resource.data.companyId == myCompanyId()))
          && request.resource.data.email == resource.data.email
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.status in ["pending", "registered", "cancelled"]
        )
        ||
        (
          isOwnPendingCompanyAdmin(email)
          && resource.data.email == request.auth.token.email
          && resource.data.status == "pending"
          && request.resource.data.email == resource.data.email
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.name == resource.data.name
          && request.resource.data.status == "registered"
          && request.resource.data.registeredUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "registeredAt", "registeredUid", "updatedAt", "updatedBy"
          ])
        );
      allow delete: if false;
    }

    // ---- デフォルト問題テンプレート ----
    // 読み取りは、questionSets/itemsと同様に「サインイン済みであれば companyId が分かれば読める」
    // 設計に合わせ、応募者（受験者）が自社未編集パートのデフォルト問題を受験時に読めるよう
    // isSignedIn() まで緩和する。書き込みは引き続きオペレーターのみ。
    match /templates/{partId} {
      allow read: if isSignedIn();
      allow write: if isOperator();

      match /items/{itemId} {
        allow read: if isSignedIn();
        allow write: if isOperator();
      }
    }

    // ---- カテゴリー（パート）定義：全社共通のデフォルトカテゴリー一覧 ----
    // 運営が「問題編集」画面から追加する。読み取りは各企業の受験フロー・問題編集画面から
    // 必要になるため、questionSets/templatesと同様にサインイン済みであれば誰でも可とする。
    match /partDefinitions/{partId} {
      allow read: if isSignedIn();
      allow write: if isOperator();
    }

    // ---- 企業 ----
    match /companies/{companyId} {
      allow get: if isOperator() || isSignedIn();
      allow list: if isOperator();
      // 企業の新規登録はオペレーターのみ。
      allow create: if isOperator();
      // 企業の状態変更（有効/停止など）はオペレーターのみ。
      // ただし利用規約への同意（termsAccepted / serviceEnabled を true にする）だけは、
      // その企業の「ビズてす申込者」である企業管理者本人が、terms-agreement.html から
      // 専用の経路で行える（他のフィールドは一切変更できない）。
      allow update: if isOperator() ||
        (
          canAcceptCompanyTerms(companyId)
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.companyName == resource.data.companyName
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "termsAccepted",
            "termsAcceptedAt",
            "termsAcceptedBy",
            "termsAcceptedByName",
            "termsAcceptedSource",
            "termsAcceptedNote",
            "termsVersion",
            "serviceEnabled",
            "updatedAt"
          ])
          && request.resource.data.termsAccepted == true
          && request.resource.data.serviceEnabled == true
          && request.resource.data.termsAcceptedBy == request.auth.uid
          && request.resource.data.termsAcceptedSource == "applicant_web_agreement"
          && request.resource.data.termsVersion == "2026-07-19"
        );
      allow delete: if false;

      // ---- 企業情報の変更履歴（operator-companies.htmlの「編集」から会社名・電話番号・
      // ご希望プラン・想定従業員数を変更した際の記録。誰が・いつ・何を変更したかを
      // 一覧の編集画面から確認できるようにするため）。編集はオペレーターのみのため、
      // 履歴の読み書きもオペレーターのみに限定する。
      match /changeLogs/{logId} {
        allow read: if isOperator();
        allow create: if isOperator()
          && request.resource.data.companyId == companyId
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.keys().hasOnly([
            "companyId", "logType", "targetCompanyId", "targetCompanyName", "action",
            "before", "after", "changes", "updatedAt", "updatedBy", "updatedByEmail",
            "updatedByName", "page"
          ]);
        allow update: if false;
        allow delete: if false;
      }

      // ---- 出題セット（パート単位の設定） ----
      match /questionSets/{partId} {
        allow get, list: if isOperator() || isSignedIn();
        allow write: if isOperator() || sameCompany(companyId);

        // ---- 個別の問題（練習/本番） ----
        match /items/{itemId} {
          allow get, list: if isOperator() || isSignedIn();
          allow write: if isOperator() || sameCompany(companyId);
        }
      }

      // ---- 自社限定カテゴリー（企業が追加する独自パート） ----
      // 一覧はquestionSets同様、受験者が受験フローで参照できるようサインイン済みなら閲覧可。
      // 追加・編集はオペレーターまたは自社の企業管理者のみ。
      match /customParts/{partId} {
        allow get, list: if isOperator() || isSignedIn();
        allow write: if isOperator() || sameCompany(companyId);
      }

      // ---- 招待メールのテンプレート（企業ごとに保存する件名・本文のひな形。v8で追加） ----
      // operator-invite-mail.html（受験招待メール作成）で編集する。応募者の受験導線には
      // 一切関与しないため、questionSets/customPartsと異なり読み取りもオペレーター・
      // 自社の企業管理者のみに限定する（応募者・他社の管理者には読ませない）。
      match /mailTemplates/{docId} {
        allow get, list: if isOperator() || sameCompany(companyId);
        allow write: if isOperator() || sameCompany(companyId);
      }

      // ---- 受験招待 ----
      match /examInvites/{token} {
        // オペレーター・自社の企業管理者は全件、応募者は「自分が開始した招待」
        // または「まだ誰も開始していない招待」のみ読める
        allow get: if isOperator() || sameCompany(companyId) ||
          (isSignedIn() &&
            (resource.data.anonUid == request.auth.uid || resource.data.status == "not_started"));
        allow list: if isOperator() || sameCompany(companyId);
        allow create, delete: if isOperator() || sameCompany(companyId);

        // 応募者が受験開始する瞬間だけ、自分のUIDを紐付ける更新を許可する。
        // 加えて、受験終了（結果送信）の瞬間に、応募者本人が自分の招待を
        // in_progress → completed に更新することも許可する（exam.htmlのsubmitExam()参照）。
        // これが無いと結果送信時のupdateDocがpermission-deniedで失敗し、
        // 「結果を送信しています…」画面のまま止まってしまう。
        allow update: if isOperator() || sameCompany(companyId) || (
          isSignedIn() &&
          resource.data.status == "not_started" &&
          request.resource.data.anonUid == request.auth.uid &&
          request.resource.data.status == "in_progress" &&
          request.resource.data.applicantName == resource.data.applicantName &&
          request.resource.data.applicantEmail == resource.data.applicantEmail
        ) || (
          isSignedIn() &&
          resource.data.status == "in_progress" &&
          resource.data.anonUid == request.auth.uid &&
          request.resource.data.anonUid == resource.data.anonUid &&
          request.resource.data.status == "completed" &&
          request.resource.data.applicantName == resource.data.applicantName &&
          request.resource.data.applicantEmail == resource.data.applicantEmail
        );
      }

      // ---- 受験結果 ----
      match /examResults/{token} {
        allow list: if isOperator() || sameCompany(companyId);
        // get は、オペレーター・自社の企業管理者に加えて、応募者本人（この結果に紐づく
        // examInvitesのanonUidが自分のuidと一致する場合）にも許可する（v9で追加）。
        // 受験後に本人へ結果を開示する画面（exam-result.html）が、company横断のlistは行わず
        // 自分のtokenの結果1件だけをgetする用途を想定している。
        allow get: if isOperator() || sameCompany(companyId) ||
          (isSignedIn() &&
            get(/databases/$(database)/documents/companies/$(companyId)/examInvites/$(token)).data.anonUid == request.auth.uid);
        // 応募者は、自分が開始した招待に紐づく結果を「1回だけ」作成できる（更新・削除は不可）
        allow create: if isSignedIn() &&
          get(/databases/$(database)/documents/companies/$(companyId)/examInvites/$(token)).data.anonUid == request.auth.uid;
        allow update, delete: if isOperator() || sameCompany(companyId);
      }
    }

    // ---- 運営レポート（全社横断）用：コレクショングループクエリ ----
    // operator-report.html（レポート・全社）は、特定企業を指定せず全企業のexamInvites /
    // examResultsを横断して集計するため、collectionGroup()クエリを使う。
    // 上の companies/{companyId}/examInvites・examResults の match ブロック内に書いた
    // allow list はそのサブコレクションへの直接クエリにしか適用されず、collectionGroup()
    // クエリには別途「/{path=**}/コレクション名」形式のトップレベルの match が必要になる
    // （Firestoreセキュリティルールの仕様）。ここではオペレーターのみに限定して許可する。
    match /{path=**}/examInvites/{token} {
      allow list: if isOperator();
    }
    match /{path=**}/examResults/{token} {
      allow list: if isOperator();
    }
  }
}
