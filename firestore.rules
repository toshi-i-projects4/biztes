rules_version = '2';

// ビズてす専用 Firestore セキュリティルール（v1ドラフト）
//
// 前提:
// - オペレーター（ビズてす運営者）は Firebase Auth のメール/パスワードでログインし、
//   operators/{uid} ドキュメントが存在することで判定する。
// - 応募者（受験者）は Firebase Anonymous Auth でサインインし、
//   companies/{companyId}/examInvites/{token} の招待トークンを知っていることを前提に受験する。
//
// 既知の制約（v1時点であえて厳密にしていない箇所）:
// - questionSets / items は「サインイン済みであれば companyId が分かれば読める」設計にしている。
//   応募者は受験中に自社の問題を読めればよく、他社の問題も理論上読める状態になる
//   （companyIdは推測困難ではないため）。問題文自体は機密性が極めて高い情報ではない想定で
//   割り切っているが、将来的にはCloud Functions経由でトークン検証してから問題を配信する方式へ
//   強化することを推奨する。
// - examInvites / examResults は token（ドキュメントID）を知らなければ辿り着けない前提。

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOperator() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/operators/$(request.auth.uid));
    }

    // ---- オペレーターアカウント ----
    match /operators/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if false;
      // 運営アカウントの作成・変更はFirebase Admin SDK / コンソールからのみ行う想定
      allow write: if false;
    }

    // ---- デフォルト問題テンプレート（オペレーターのみ） ----
    match /templates/{partId} {
      allow read, write: if isOperator();

      match /items/{itemId} {
        allow read, write: if isOperator();
      }
    }

    // ---- 企業 ----
    match /companies/{companyId} {
      allow get: if isOperator() || isSignedIn();
      allow list: if isOperator();
      allow write: if isOperator();

      // ---- 出題セット（パート単位の設定） ----
      match /questionSets/{partId} {
        allow get, list: if isOperator() || isSignedIn();
        allow write: if isOperator();

        // ---- 個別の問題（練習/本番） ----
        match /items/{itemId} {
          allow get, list: if isOperator() || isSignedIn();
          allow write: if isOperator();
        }
      }

      // ---- 受験招待 ----
      match /examInvites/{token} {
        // オペレーターは全件、応募者は「自分が開始した招待」または「まだ誰も開始していない招待」のみ読める
        allow get: if isOperator() ||
          (isSignedIn() &&
            (resource.data.anonUid == request.auth.uid || resource.data.status == "not_started"));
        allow list: if isOperator();
        allow create, delete: if isOperator();

        // 応募者が受験開始する瞬間だけ、自分のUIDを紐付ける更新を許可する
        allow update: if isOperator() || (
          isSignedIn() &&
          resource.data.status == "not_started" &&
          request.resource.data.anonUid == request.auth.uid &&
          request.resource.data.status == "in_progress" &&
          request.resource.data.applicantName == resource.data.applicantName &&
          request.resource.data.applicantEmail == resource.data.applicantEmail
        );
      }

      // ---- 受験結果 ----
      match /examResults/{token} {
        allow get, list: if isOperator();
        // 応募者は、自分が開始した招待に紐づく結果を「1回だけ」作成できる（更新・削除は不可）
        allow create: if isSignedIn() &&
          get(/databases/$(database)/documents/companies/$(companyId)/examInvites/$(token)).data.anonUid == request.auth.uid;
        allow update, delete: if isOperator();
      }
    }
  }
}
